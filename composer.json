{
  "name": "perspeqtive/sulu-permission-aware-collections-bundle",
  "autoload": {
    "psr-4": {
      "PERSPEQTIVE\\SuluPermissionAwareCollectionsBundle\\": "src/"
    }
  },
  "authors": [
    {
      "name": "PERSPEQTIVE GmbH"
    }
  ],
  "require": {
    "php": "^8.2",
    "sulu/sulu": "^2.6",
    "perspeqtive/sulu-access-control-custom-query-enhancer-bundle": "*@dev"
    },
    "require-dev": {
      "phpunit/phpunit": "^12",
      "jackalope/jackalope-doctrine-dbal": "^1.3.4 || ^2.0",
      "php-cs-fixer/shim": "^3.75",
      "phpstan/phpstan": "^2.1",
      "phpstan/phpstan-phpunit": "^2.0",
      "phpstan/phpstan-symfony": "^2.0"
    },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "repositories": {
    "perspeqtive/sulu-access-control-custom-query-enhancer-bundle": {
      "type": "vcs",
      "url": "https://github.com/perspeqtive/sulu-access-control-custom-query-enhancer-bundle.git"
    }
  }
}
